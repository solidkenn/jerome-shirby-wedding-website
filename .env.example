# Deployed upload API (API/files on Vercel) — POST multipart field "file"
VITE_UPLOAD_URL=https://uploadtesting-mu.vercel.app/api/upload

# Security: never put BLOB_READ_WRITE_TOKEN or other server secrets in this project.
# Only public VITE_* URLs belong here (they are embedded in the browser bundle).

# Public site address, no trailing slash. Required so Messenger and iMessage can load the share image.
VITE_SITE_URL=https://jerome-shirby-wedding-website.vercel.app

# Local dev: copy to .env.local and use the proxy in vite.config.js
# VITE_UPLOAD_URL=/api/upload
# VITE_UPLOAD_PROXY_TARGET=https://uploadtesting-mu.vercel.app
